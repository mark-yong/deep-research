OPENAI_API_KEY=

# LiteLLM gateway (OpenAI-compatible). Models default to the alias
# "openai:research" which resolves at this base URL; change the model
# behind the gateway without touching this repo. The value is forwarded
# to the OpenAI client via OPENAI_API_BASE at import time.
RESEARCH_BASE_URL=http://localhost:4000/v1

# Multi-provider search MCP server (stdio URL for the search tools).
# Any MCP server exposing a web_search-style tool works here.
SEARCH_MCP_URL=http://localhost:8080/mcp

# Self-hosted SearXNG via MCP bridge (isokoliuk/mcp-searxng). Expose the
# bridge with an HTTP port and point SEARCH_MCP_URL at it.
SEARCH_MCP_URL=http://your-host:8080/mcp

# Legacy names from the April 2026 setup (no longer read by code):
#   MINIMAX_BASE_URL / MINIMAX_MODEL / SEARXNG_MCP_URL

ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
GET_API_KEYS_FROM_CONFIG=false
